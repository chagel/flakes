---
const pillars = [
  {
    title: 'Productivity',
    description: 'No address bar clutter. No tab overload. Just you and the content. Focus mode, smart history, and distraction-free browsing.',
    icon: 'focus',
  },
  {
    title: 'Keyboard-First',
    description: 'Vim-style navigation with h/j/k/l. Command palette with ⌘K. Link hints with f. From browsing pages to window management, your hands never leave the keyboard.',
    icon: 'keyboard',
  },
  {
    title: 'Advanced AI',
    description: 'Drift AI understands your tabs. Get direct answers across all open pages. Real-time translation. Deep conversations about any content.',
    icon: 'ai',
  },
  {
    title: 'Native & Fast',
    description: 'Built with SwiftUI and WebKit. Instant cold start. Smooth scrolling. Minimal memory footprint. Feels like a true macOS app.',
    icon: 'speed',
  },
];
---

<section id="features" class="py-16 sm:py-24">
  <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:max-w-7xl lg:px-8">
    <div class="grid gap-8 sm:gap-12 lg:grid-cols-2">
      {pillars.map((pillar) => (
        <div class="flex flex-col gap-4 p-6 sm:p-8 rounded-2xl bg-primary-500/5 dark:bg-primary-400/5 border border-primary-500/10 dark:border-primary-400/10">
          <!-- Icon -->
          <div class="w-10 h-10 rounded-xl bg-primary-500/10 dark:bg-primary-400/10 flex items-center justify-center">
            {pillar.icon === 'focus' && (
              <svg class="w-5 h-5 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            )}
            {pillar.icon === 'keyboard' && (
              <svg class="w-5 h-5 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/>
              </svg>
            )}
            {pillar.icon === 'ai' && (
              <svg class="w-5 h-5 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
              </svg>
            )}
            {pillar.icon === 'speed' && (
              <svg class="w-5 h-5 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"/>
              </svg>
            )}
          </div>

          <!-- Content -->
          <div class="flex flex-col gap-2">
            <h3 class="text-xl font-medium">{pillar.title}</h3>
            <p class="text-primary-950/60 dark:text-primary-200/60 text-base leading-relaxed">
              {pillar.description}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
