---
const features = [
  {
    title: 'Command Palette',
    subtitle: 'One shortcut to rule them all',
    description: 'Press ⌘K to access everything—search history, run commands, open URLs, ask AI. No more hunting through menus or memorizing dozens of shortcuts.',
    shortcut: '⌘K',
    media: '/assets/Flakes-drift.mp4',
    type: 'video',
    align: 'left',
  },
  {
    title: 'Keyboard Navigation',
    subtitle: 'Browse without the mouse',
    description: 'Vim-style navigation with h/j/k/l. Press f to show link hints. Switch tabs, scroll pages, and manage windows—all from your keyboard.',
    shortcut: 'hjkl',
    media: '/assets/Flakes-vim.mp4',
    type: 'video',
    align: 'right',
  },
  {
    title: 'AI That Understands Context',
    subtitle: 'Ask questions, get answers',
    description: 'Drift AI reads your open tabs and gives direct answers. Translate pages in real-time. Have deep conversations about any content you\'re viewing.',
    shortcut: 'AI',
    media: '/assets/Flakes-ai.mp4',
    type: 'video',
    align: 'left',
  },
  {
    title: 'Focus Mode',
    subtitle: 'Content without distractions',
    description: 'Press ⌘Enter to hide everything but the content. Built-in ad blocking removes clutter. No toolbar, no address bar—just you and what you\'re reading.',
    shortcut: '⌘⏎',
    media: '/assets/Flakes-focus.mp4',
    type: 'video',
    align: 'right',
  },
  {
    title: 'Privacy Built In',
    subtitle: 'Your data stays yours',
    description: 'Local browser with ad blocking by default. We keep privacy in mind and carefully craft AI features—which is optional. Private mode leaves no history and is totally isolated in memory.',
    shortcut: '🔒',
    media: '/assets/Flakes-private.mp4',
    type: 'video',
    align: 'left',
  },
];
---

<section class="py-16 sm:py-24">
  <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:max-w-6xl lg:px-8">
    <!-- Section header -->
    <div class="text-center mb-16 sm:mb-20">
      <h2 class="text-3xl font-medium tracking-tight sm:text-4xl mb-4">
        How Flakes works
      </h2>
      <p class="text-primary-950/60 dark:text-primary-200/60 text-lg max-w-2xl mx-auto">
        Every feature is designed to help you work faster and stay focused.
      </p>
    </div>

    <!-- Feature rows -->
    <div class="flex flex-col gap-16 sm:gap-24">
      {features.map((feature, index) => (
        <div class={`flex flex-col gap-8 lg:gap-12 lg:items-center ${feature.align === 'right' ? 'lg:flex-row-reverse' : 'lg:flex-row'}`}>
          <!-- Media -->
          <div class="flex-1">
            <div class="relative aspect-[4/3] rounded-2xl bg-primary-100 dark:bg-primary-800/50 overflow-hidden border border-primary-200/50 dark:border-primary-700/50">
              {feature.type === 'video' ? (
                <video
                  src={feature.media}
                  loop
                  muted
                  playsinline
                  preload="metadata"
                  class="w-full h-full object-cover feature-video"
                />
              ) : feature.media && !feature.media.includes('placeholder') ? (
                <img src={feature.media} alt={feature.title} class="w-full h-full object-cover" />
              ) : (
                <div class="absolute inset-0 flex items-center justify-center">
                  <div class="text-center">
                    <kbd class="inline-block px-4 py-2 bg-primary-200 dark:bg-primary-700 rounded-lg text-primary-600 dark:text-primary-300 font-mono text-2xl mb-3">
                      {feature.shortcut}
                    </kbd>
                    <p class="text-sm text-primary-400 dark:text-primary-500">Coming soon</p>
                  </div>
                </div>
              )}
            </div>
          </div>

          <!-- Content -->
          <div class="flex-1 lg:max-w-md">
            <p class="text-sm font-medium text-primary-600 dark:text-primary-400 mb-2">
              {feature.subtitle}
            </p>
            <h3 class="text-2xl sm:text-3xl font-medium tracking-tight mb-4">
              {feature.title}
            </h3>
            <p class="text-primary-950/60 dark:text-primary-200/60 text-base sm:text-lg leading-relaxed">
              {feature.description}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  // Play videos only when visible in viewport
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      const video = entry.target as HTMLVideoElement;
      if (entry.isIntersecting) {
        video.play();
      } else {
        video.pause();
      }
    });
  }, { threshold: 0.3 });

  document.querySelectorAll('.feature-video').forEach(video => {
    observer.observe(video);
  });
</script>
