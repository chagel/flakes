---
const testimonials = [
  {
    quote: "Finally, a browser that matches how I think. The keyboard navigation alone saves me hours each week.",
    author: "James",
    role: "CEO",
    highlight: "keyboard navigation",
  },
  {
    quote: "Drift AI is incredible. I ask questions and get answers from all my open tabs instantly. No more context switching.",
    author: "Xu",
    role: "Product Designer",
    highlight: "Drift AI",
  },
  {
    quote: "Native performance + zero tracking. It's the browser I've been waiting for since switching to Mac.",
    author: "Jack Wu",
    role: "Software Engineer",
    highlight: "Native performance",
  },
];
---

<section class="py-16 sm:py-24">
  <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:max-w-6xl lg:px-8">
    <!-- Header -->
    <div class="text-center mb-12 sm:mb-16">
      <p class="text-sm font-medium text-primary-600 dark:text-primary-400 mb-3">
        Early feedback
      </p>
      <h2 class="text-3xl font-medium tracking-tight sm:text-4xl">
        What people are saying
      </h2>
    </div>

    <!-- Testimonials grid -->
    <div class="grid gap-6 lg:grid-cols-3">
      {testimonials.map((t) => (
        <div class="relative p-6 sm:p-8 rounded-2xl bg-primary-500/5 dark:bg-primary-400/5 border border-primary-500/10 dark:border-primary-400/10">
          <!-- Quote icon -->
          <svg class="w-8 h-8 text-primary-300 dark:text-primary-700 mb-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M4.583 17.321C3.553 16.227 3 15 3 13.011c0-3.5 2.457-6.637 6.03-8.188l.893 1.378c-3.335 1.804-3.987 4.145-4.247 5.621.537-.278 1.24-.375 1.929-.311 1.804.167 3.226 1.648 3.226 3.489a3.5 3.5 0 01-3.5 3.5c-1.073 0-2.099-.49-2.748-1.179zm10 0C13.553 16.227 13 15 13 13.011c0-3.5 2.457-6.637 6.03-8.188l.893 1.378c-3.335 1.804-3.987 4.145-4.247 5.621.537-.278 1.24-.375 1.929-.311 1.804.167 3.226 1.648 3.226 3.489a3.5 3.5 0 01-3.5 3.5c-1.073 0-2.099-.49-2.748-1.179z"/>
          </svg>

          <!-- Quote -->
          <blockquote class="text-base sm:text-lg leading-relaxed text-primary-950/80 dark:text-primary-200/80 mb-6">
            {t.quote}
          </blockquote>

          <!-- Author -->
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-primary-200 dark:bg-primary-800 flex items-center justify-center">
              <span class="text-sm font-medium text-primary-600 dark:text-primary-400">
                {t.author.charAt(0)}
              </span>
            </div>
            <div>
              <p class="font-medium text-sm">{t.author}</p>
              <p class="text-xs text-primary-950/50 dark:text-primary-200/50">{t.role}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
